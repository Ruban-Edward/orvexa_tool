# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
# Options: development, testing, production
CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APP SETTINGS
# --------------------------------------------------------------------
app.baseURL = 'https://your-domain.com/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = true

# --------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------
database.default.hostname = mysql
database.default.database = orvexa
database.default.username = your_db_user
database.default.password = your_db_strong_password
database.default.DBDriver = MySQLi
database.default.port = 3306

# --------------------------------------------------------------------
# EMAIL (SMTP)
# --------------------------------------------------------------------
email.fromEmail = 'no-reply@your-domain.com'
email.fromName  = 'Orvexa'
email.SMTPHost  = 'smtp.gmail.com'
email.SMTPUser  = 'your-email@example.com'
email.SMTPPass  = 'your-app-password'
email.SMTPPort  = 465

# --------------------------------------------------------------------
# ENCRYPTION KEY (Generate with: php spark key:generate --show)
# --------------------------------------------------------------------
# encryption.key = 
